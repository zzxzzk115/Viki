@article{kass_coherent_2011,
	title = {Coherent noise for non-photorealistic rendering},
	volume = {30},
	issn = {0730-0301},
	url = {https://dl.acm.org/doi/10.1145/2010324.1964925},
	doi = {10.1145/2010324.1964925},
	abstract = {A wide variety of non-photorealistic rendering techniques make use of random variation in the placement or appearance of primitives. In order to avoid the "shower-door" effect, this random variation should move with the objects in the scene. Here we present coherent noise tailored to this purpose. We compute the coherent noise with a specialized filter that uses the depth and velocity fields of a source sequence. The computation is fast and suitable for interactive applications like games.},
	number = {4},
	urldate = {2026-06-09},
	journal = {ACM Trans. Graph.},
	author = {Kass, Michael and Pesare, Davide},
	month = jul,
	year = {2011},
	pages = {30:1--30:6},
}

@inproceedings{ye_rectangular_2022,
	title = {Rectangular {Mapping}-based {Foveated} {Rendering}},
	url = {https://ieeexplore.ieee.org/document/9756831/},
	doi = {10.1109/VR51125.2022.00097},
	abstract = {With the speedy increase of display resolution and the demand for interactive frame rate, rendering acceleration is becoming more critical for a wide range of virtual reality applications. Foveated rendering addresses this challenge by rendering with a non-uniform resolution for the display. Motivated by the non-linear optical lens equation, we present rectangular mapping-based foveated rendering (RMFR), a simple yet effective implementation of foveated rendering framework. RMFR supports varying level of foveation according to the eccentricity and the scene complexity. Compared with traditional foveated rendering methods, rectangular mapping-based foveated rendering provides a superior level of perceived visual quality while consuming minimal rendering cost.},
	urldate = {2026-06-05},
	booktitle = {2022 {IEEE} {Conference} on {Virtual} {Reality} and {3D} {User} {Interfaces} ({VR})},
	author = {Ye, Jiannan and Xie, Anqi and Jabbireddy, Susmija and Li, Yunchuan and Yang, Xubo and Meng, Xiaoxu},
	month = mar,
	year = {2022},
	note = {ISSN: 2642-5254},
	keywords = {Computer graphics, Computing methodologies, Costs, Human-centered computing, Optical buffering, Pipelines, Rendering, Three-dimensional displays, User interfaces, Virtual reality, Visibility, Visualization, Visualization design and evaluation methods},
	pages = {756--764},
}

@inproceedings{shi_locomotion-aware_2023,
	title = {Locomotion-aware {Foveated} {Rendering}},
	url = {https://ieeexplore.ieee.org/document/10108455/},
	doi = {10.1109/VR55154.2023.00062},
	abstract = {Optimizing rendering performance improves the user's immersion in virtual scene exploration. Foveated rendering uses the features of the human visual system (HVS) to improve rendering performance without sacrificing perceptual visual quality. We collect and analyze the viewing motion of different locomotion methods, and describe the effects of these viewing motions on HVS's sensitivity, as well as the advantages of these effects that may bring to foveated rendering. Then we propose the locomotion-aware foveated rendering method (LaFR) to further accelerate foveated rendering by leveraging the advantages. In LaFR, we first introduce the framework of LaFR. Secondly, we propose an eccentricity-based shading rate controller that provides the shading rate control of the given region in foveated rendering. Thirdly, we propose a locomotion-aware log-polar mapping method, which controls the foveal average shading rate, the peripheral shading rate decrease speed, and the overall shading quantity with the locomotion-aware coefficients based on the eccentricity-based shading rate controller. LaFR achieves similar perceptual visual quality as the conventional foveated rendering while achieving up to 1.6× speedup. Compared with the full resolution rendering, LaFR achieves up to 3.8× speedup.},
	urldate = {2026-06-01},
	booktitle = {2023 {IEEE} {Conference} {Virtual} {Reality} and {3D} {User} {Interfaces} ({VR})},
	author = {Shi, Xuehuai and Wang, Lili and Wu, Jian and Ke, Wei and Lam, Chan-Tong},
	month = mar,
	year = {2023},
	note = {ISSN: 2642-5254},
	keywords = {Foveated Rendering, Gaze-contingent Rendering, Perception, Rendering (computer graphics), Sensitivity, Three-dimensional displays, User interfaces, Virtual Reality, Virtual reality, Visual systems, Visualization},
	pages = {471--481},
}

@article{gao_deep-saliency_2026,
	title = {Deep-{Saliency} {Foveated} {Ray} {Tracing} for {Real}-time {VR} {Rendering}},
	issn = {1941-0506},
	url = {https://ieeexplore.ieee.org/document/11458020/},
	doi = {10.1109/TVCG.2026.3679110},
	abstract = {Immersive VR applications demand high resolutions and refresh rates, posing significant challenges for real-time rendering. Foveated rendering mitigates this cost by exploiting properties of the Human Visual System (HVS), but conventional approaches often rely on oversimplified heuristic models that neglect high-level attentional cues, resulting in artifacts in peripheral regions. To this end, we present a neural saliency-driven foveated ray tracing framework that overcomes these limitations. Our method introduces a motion-aware foveation model to capture temporal dynamics and employs a lightweight convolutional neural network to predict saliency maps that reflect complex attentional patterns derived from eye-gaze data. The combination of these guides adaptive path tracing and filtering, enabling perceptually optimized rendering with minimal artifacts. Experimental results show that our approach improves perceptual quality over prior methods while sustaining real-time performance.},
	urldate = {2026-04-20},
	journal = {IEEE Transactions on Visualization and Computer Graphics},
	author = {Gao, Yang and Li, Wencan and Liang, Shiyu and Feng, Weizichuan and Xia, Qing and Li, Shuai and Hao, Aimin},
	year = {2026},
	keywords = {Accuracy, Filters, Foveated rendering, Hardware, Image color analysis, Pipelines, Ray tracing, Real-time systems, Rendering (computer graphics), Solid modeling, VR rendering, Visualization, ray tracing, saliency map},
	pages = {1--11},
}


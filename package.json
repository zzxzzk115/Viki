{
  "name": "viki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "content:watch": "tsx watch scripts/build-content.ts",
    "links": "tsx scripts/check-links.ts",
    "papers": "tsx scripts/fetch-papers.ts",
    "papers:dry": "tsx scripts/fetch-papers.ts --dry",
    "import-bibtex": "tsx scripts/import-bibtex.ts",
    "import-bibtex:dry": "tsx scripts/import-bibtex.ts --dry",
    "citations": "tsx scripts/fetch-citations.ts",
    "data:pull": "git fetch origin data && git checkout origin/data -- data",
    "dev": "pnpm content && next dev",
    "build": "pnpm content && next build && pnpm links",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
